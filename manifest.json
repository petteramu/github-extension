{
  "manifest_version": 3,
  "name": "GitHub PR Reverse Conversation",
  "version": "1.0.1",
  "description": "Shows GitHub pull request conversations newest first and lets you filter the timeline to a single reviewer.",
  "browser_specific_settings": {
    "gecko": {
      "id": "github-pr-reverse@petter.amundsen",
      "strict_min_version": "142.0",
      "update_url": "https://raw.githubusercontent.com/petteramu/github-extension/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "css": ["reverse.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://github.com/*"],
      "js": ["reviewer-filter.js"],
      "run_at": "document_idle"
    }
  ]
}
